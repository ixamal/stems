# macOS
.DS_Store
.AppleDouble
.LSOverride

# Secrets / env
.env
.env.*
*.enc
box.key
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local extract / convert manifests
config/*.json
config/*.txt
config/nuo_drop_*/

# Path lists (absolute paths on this Mac — not for git)
m3u/*.m3u
m3u/*.txt

# Run artifacts (absolute library paths on ix)
log/*.log
log/*.json
log/*.png
log/*.out
log/*.pid
:memory:.ses

# Editor
.idea/
*.swp

# Audio / collections never belong in git
*.mp3
*.m4a
*.mp4
*.wav
*.aiff
*.aif
*.flac
*.stem.m4a
*.stem.mp4
*.nml
*.tsi
*.xml
*.trak
master.db
